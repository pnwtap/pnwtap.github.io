<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>pnwtap</title>
  <meta name="description" content="A daily Pacific Northwest map-tapping game: four places, one unlabelled map.">
  <meta property="og:title" content="pnwtap — daily PNW map game">
  <meta property="og:description" content="Four places around WA, OR, BC and AB. Tap where they are on an unlabelled satellite map.">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#2f523e">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%232f523e'/><path d='M8 50 26 20l9 14 6-8 15 24z' fill='%23faf6ea'/><circle cx='44' cy='18' r='6' fill='%23c0392b'/></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="style.css?v={{ v }}">
</head>
<body>
  <div id="map"></div>
  <div id="card">
    <div id="card-head">
      <span class="wordmark">pnwtap <span id="puzzle-no"></span></span>
      <span class="head-right">
        <span id="round-pill" class="round-pill"></span>
        <button id="head-action" class="head-action" hidden></button>
        <button id="help-btn" class="icon-btn" aria-label="How to play">?</button>
      </span>
    </div>
    <div id="card-body" aria-live="polite"></div>
  </div>
  <div id="help" hidden>
    <div class="help-card" role="dialog" aria-labelledby="help-title">
      <h2 id="help-title">How to play</h2>
      <p class="help-lead">Tap where each place is. Closer scores more (up to 100); later rounds
        count for more: <span id="help-tiers"></span>. Lines and areas count anywhere along or inside.
        New puzzle at midnight Pacific.</p>
      <button class="primary">Got it</button>
    </div>
  </div>
  <div id="feedback" hidden>
    <form class="help-card fb-card" id="fb-form" novalidate>
      <h2 id="fb-title">Suggest a place</h2>
      <fieldset data-kind="place">
        <label>Place<input name="place" maxlength="120" required placeholder="e.g. Mt Shuksan, Exit 32, Leavenworth"></label>
        <label>Where is it?<input name="where" maxlength="400" placeholder="a Google Maps link, lat,lng, or a description"></label>
        <label>Why it's a good one <span class="opt">(optional)</span><textarea name="why" rows="3" maxlength="1500" placeholder="a fun fact, elevation, grade…"></textarea></label>
      </fieldset>
      <fieldset data-kind="bug">
        <label>What went wrong?<textarea name="what" rows="4" maxlength="3000" required placeholder="e.g. Crypt Lake is pinned in the wrong valley"></textarea></label>
        <label>About which place? <span class="opt">(optional)</span><select name="about"></select></label>
      </fieldset>
      <label>Your name or email <span class="opt">(optional, if you'd like a reply)</span><input name="contact" maxlength="200" autocomplete="email"></label>
      <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">
      <p class="fb-status" aria-live="polite"></p>
      <div class="fb-actions">
        <button type="button" class="secondary" id="fb-cancel">Cancel</button>
        <button type="submit" class="primary" id="fb-send">Send</button>
      </div>
    </form>
  </div>
  <script>window.PNWTAP = {{ data_json | safe }};</script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  {% if goatcounter %}
  <script>window.goatcounter = { no_onload: true };</script>
  <script data-goatcounter="https://{{ goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  {% endif %}
  <script src="scoring.js?v={{ v }}"></script>
  <script src="game.js?v={{ v }}"></script>
</body>
</html>
